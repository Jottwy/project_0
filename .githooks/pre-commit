#!/usr/bin/env bash
# Gate de commit para los commits que NO pasan por Claude: terminal, IDE, otra sesion.
#
# NO esta activo por defecto. Git no ejecuta hooks versionados: hay que apuntarle una vez por
# clon, y el ajuste vive en la configuracion del repositorio (compartida por todos sus worktrees):
#
#     git config core.hooksPath .githooks
#
# Por que existe ademas del hook PreToolUse de Claude, y por que ninguno de los dos sobra:
#
#   - El PreToolUse cubre SOLO lo que Claude ejecuta por la tool Bash, pero no necesita que nadie
#     lo active, no se puede saltar con `--no-verify` y viaja con el repositorio.
#   - Este cubre CUALQUIER `git commit` de la maquina, tambien los que escribe una persona a mano,
#     pero hay que activarlo en cada clon y `git commit --no-verify` lo salta sin decir nada.
#
# Los dos llaman al MISMO script, asi que la regla es una sola y no hay dos verdades que mantener.

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
gate="$root/tools/dev/validate-scope.ps1"

if [ ! -f "$gate" ]; then
    echo "pre-commit: no encuentro $gate; sin gate no se commitea (fail closed)" >&2
    exit 2
fi

powershell_exe="${SystemRoot:-C:\\Windows}/System32/WindowsPowerShell/v1.0/powershell.exe"
if [ ! -x "$powershell_exe" ]; then
    powershell_exe="powershell"
fi

"$powershell_exe" -NoProfile -ExecutionPolicy Bypass -File "$gate"
