<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>natverify</AssemblyName>
    <RootNamespace>natverify</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0618;CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="NUnitShim.cs" />
    <Compile Include="Runner.cs" />
  </ItemGroup>

  <!-- El codigo REAL, no una copia. Se excluye HostConnectivityRunner.cs porque usa UnityEngine. -->
  <ItemGroup>
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\NatAddressPolicy.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\HostConnectivityReport.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\CgnatHeuristic.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\SsdpMessage.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\SsdpProbe.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\IgdDescription.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\IgdSoap.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\IgdClient.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\IgdLocator.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\PublicIpResolver.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\HostConnectivityService.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Connectivity\HostEndpointCandidates.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Lobbies\LobbyEndpointPolicy.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Network\HostAddressInput.cs" />
    <!-- El sorteo de loot y el de contenedores: puros por diseno, sin UnityEngine. -->
    <Compile Include="$(Repo)\Assets\Scripts\Network\ChunkLootRoll.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Network\ChunkContainerRoll.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Network\ChunkDismantleRoll.cs" />
    <!-- ADR-115: la traduccion del sello de mundo al reloj local, extraida justamente para
         poder probarla sin editor. -->
    <Compile Include="$(Repo)\Assets\Scripts\Network\LootMarkClock.cs" />
    <!-- ADR-117: el modelo de lobby y la publicacion. Ninguno toca UnityEngine ni Steamworks -la
         costura contra Steam es una interfaz- y son justo donde vive la regla que R1 cambia: que
         un lobby con relay y sin connect_ip SI se puede publicar y SI se puede entrar. -->
    <Compile Include="$(Repo)\Assets\Scripts\Lobbies\Lobby.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Lobbies\ILobbyPublisher.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Lobbies\SteamLobbyPublisher.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Lobbies\HostAnnouncementDriver.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Lobbies\LobbyJoinRouter.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Lobbies\SteamLobbyRecord.cs" />
    <Compile Include="$(Repo)\Assets\Scripts\Lobbies\LobbyList.cs" />
  </ItemGroup>

  <!-- Los ficheros de test REALES, sin tocar. LanFallbackMetadataTests queda fuera: depende de
       SteamLobbyManager, que arrastra Steamworks y UnityEngine. -->
  <ItemGroup>
    <Compile Include="$(Repo)\Assets\Tests\EditMode\FakeUpnpDevice.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\ChunkContainerRollTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\ChunkDismantleRollTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\LootMarkClockTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\NatAddressPolicyTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\HostConnectivityReportTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\CgnatHeuristicTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\IgdProtocolTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\IgdClientTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\PublicIpResolverTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\HostConnectivityServiceTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\HostEndpointPrecedenceTests.cs" />
    <!-- ADR-117. `ServerBrowserSessionGateTests` y `LanFallbackMetadataTests` siguen fuera: usan
         SessionState y SteamLobbyManager, que arrastran UnityEngine y Steamworks. -->
    <Compile Include="$(Repo)\Assets\Tests\EditMode\LobbyModelTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\SteamLobbyMapperTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\SteamLobbyPublisherTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\LobbyJoinRouterTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\RelayLobbyTests.cs" />
    <Compile Include="$(Repo)\Assets\Tests\EditMode\HostAddressInputTests.cs" />
  </ItemGroup>

</Project>
